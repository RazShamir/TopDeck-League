# Google Sheets Configuration
SPREADSHEET_KEY=your-google-spreadsheet-key-here

# Optional: override worksheet names (defaults shown below)
SUMMARY_TAB=Summary
HISTORY_TAB=History

# API Authentication Token (choose a strong random token)
API_TOKEN=your-secure-api-token-here

# Notes:
# - The SPREADSHEET_KEY is found in your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/{SPREADSHEET_KEY}/edit
# - Share your spreadsheet with the service account email (found in service_account.json)
# - Keep service_account.json secure and never commit it to version control
# - The API_TOKEN is used to authenticate API requests via X-API-Token header
